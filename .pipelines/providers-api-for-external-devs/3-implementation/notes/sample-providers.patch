+import { Readable } from 'node:stream';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { ConnectError, NotConnectedError } from '../../errors';
+import { sampleHostingAccount } from '../account';
+import { sampleHostingSites } from '../sites';
+
+const json = ( status: number, body: unknown = {} ) =>
+	new Response( JSON.stringify( body ), { status } );
+
+const config = { accessToken: 'token-1', account: 'ada@example.com' };
+
+const handoff = () => ( {
+	deviceCode: 'device-1',
+	interval: '0.001',
+	expiresAt: String( Date.now() + 60_000 ),
+} );
+
+afterEach( () => {
+	vi.unstubAllGlobals();
+} );
+
+describe( 'sample-hosting account', () => {
+	it( 'starts a device sign-in', async () => {
+		vi.stubGlobal(
+			'fetch',
+			vi.fn( async () =>
+				json( 200, {
+					device_code: 'device-1',
+					user_code: 'ABCD-1234',
+					verification_uri: 'http://127.0.0.1:11600/activate',
+					interval: 5,
+					expires_in: 900,
+				} )
+			)
+		);
+
+		await expect( sampleHostingAccount.start!( 'sign-in', { hostId: 'host' } ) ).resolves.toEqual( {
+			url: 'http://127.0.0.1:11600/activate',
+			code: 'ABCD-1234',
+			handoff: { deviceCode: 'device-1', interval: '5', expiresAt: expect.any( String ) },
+		} );
+	} );
+
+	it( 'waits for the approval, then stores the token and the account', async () => {
+		const answers = [
+			json( 428, { error: 'authorization_pending' } ),
+			json( 200, { access_token: 'token-1', account: 'ada@example.com' } ),
+		];
+		const fetchMock = vi.fn( async () => answers.shift()! );
+		vi.stubGlobal( 'fetch', fetchMock );
+
+		await expect( sampleHostingAccount.connect( 'sign-in', handoff() ) ).resolves.toEqual( config );
+		expect( fetchMock ).toHaveBeenCalledTimes( 2 );
+		expect( fetchMock ).toHaveBeenCalledWith(
+			'http://127.0.0.1:11600/device/token',
+			expect.objectContaining( { body: JSON.stringify( { device_code: 'device-1' } ) } )
+		);
+	} );
+
+	it( 'says when the sign-in is declined or the code expired', async () => {
+		vi.stubGlobal(
+			'fetch',
+			vi.fn( async () => json( 403, { error: 'denied' } ) )
+		);
+		await expect( sampleHostingAccount.connect( 'sign-in', handoff() ) ).rejects.toMatchObject( {
+			reason: 'denied',
+		} );
+
+		vi.stubGlobal(
+			'fetch',
+			vi.fn( async () => json( 400, { error: 'expired' } ) )
+		);
+		await expect( sampleHostingAccount.connect( 'sign-in', handoff() ) ).rejects.toBeInstanceOf(
+			ConnectError
+		);
+	} );
+} );
+
+describe( 'sample-hosting sites', () => {
+	it( 'lists the account’s sites and asks to connect again when the token no longer works', async () => {
+		const sites = [ { id: 's1', name: 'Blog', url: 'http://blog.example' } ];
+		const fetchMock = vi.fn( async () => json( 200, sites ) );
+		vi.stubGlobal( 'fetch', fetchMock );
+
+		await expect( sampleHostingSites.list( config ) ).resolves.toEqual( sites );
+		expect( fetchMock ).toHaveBeenCalledWith(
+			'http://127.0.0.1:11600/sites',
+			expect.objectContaining( { headers: { Authorization: 'Bearer token-1' } } )
+		);
+
+		vi.stubGlobal(
+			'fetch',
+			vi.fn( async () => json( 401 ) )
+		);
+		await expect( sampleHostingSites.list( config ) ).rejects.toBeInstanceOf( NotConnectedError );
+		await expect( sampleHostingSites.list( undefined ) ).rejects.toBeInstanceOf(
+			NotConnectedError
+		);
+	} );
+
+	it( 'creates a site named after the local one', async () => {
+		const fetchMock = vi.fn( async () =>
+			json( 201, { id: 's2', name: 'Shop', url: 'http://shop.example' } )
+		);
+		vi.stubGlobal( 'fetch', fetchMock );
+
+		await expect( sampleHostingSites.create( config, { name: 'Shop' } ) ).resolves.toEqual( {
+			id: 's2',
+			name: 'Shop',
+			url: 'http://shop.example',
+		} );
+		expect( fetchMock ).toHaveBeenCalledWith(
+			'http://127.0.0.1:11600/sites',
+			expect.objectContaining( { method: 'POST', body: JSON.stringify( { name: 'Shop' } ) } )
+		);
+	} );
+
+	it.each( [
+		[ 'a Blob', () => new Blob( [ 'archive' ] ) ],
+		[ 'a stream', () => Readable.from( [ Buffer.from( 'archive' ) ] ) ],
+	] )( 'uploads the archive from %s with its file name', async ( _kind, file ) => {
+		const fetchMock = vi.fn( async () => json( 200, { ok: true, size: 7 } ) );
+		vi.stubGlobal( 'fetch', fetchMock );
+		const onStatus = vi.fn();
+
+		await sampleHostingSites.push(
+			config,
+			{ id: 's1', name: 'Blog' },
+			{ kind: 'archive', file: file(), name: 'blog.tar.gz', size: 7 },
+			{ optionsToSync: [ 'all' ] } as never,
+			onStatus
+		);
+
+		expect( onStatus ).toHaveBeenCalledWith( { phase: 'uploading' } );
+		expect( fetchMock ).toHaveBeenCalledWith(
+			'http://127.0.0.1:11600/sites/s1/archive',
+			expect.objectContaining( {
+				method: 'PUT',
+				headers: expect.objectContaining( {
+					Authorization: 'Bearer token-1',
+					'x-archive-name': 'blog.tar.gz',
+				} ),
+			} )
+		);
+	} );
+
+	it( 'asks to connect again when the push is refused with a 401', async () => {
+		vi.stubGlobal(
+			'fetch',
+			vi.fn( async () => json( 401 ) )
+		);
+
+		await expect(
+			sampleHostingSites.push(
+				config,
+				{ id: 's1', name: 'Blog' },
+				{ kind: 'archive', file: new Blob( [ 'archive' ] ), name: 'blog.tar.gz', size: 7 },
+				{ optionsToSync: [ 'all' ] } as never,
+				() => undefined
+			)
+		).rejects.toBeInstanceOf( NotConnectedError );
+	} );
+} );
