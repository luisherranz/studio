+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { ConnectError, NotConnectedError } from '../../errors';
+import { sampleChatAccount } from '../account';
+import { sampleChatAi } from '../ai';
+
+afterEach( () => {
+	vi.unstubAllGlobals();
+} );
+
+describe( 'sample-chat account', () => {
+	const connect = ( response: Partial< Response > | Error ) => {
+		const fetchMock =
+			response instanceof Error
+				? vi.fn().mockRejectedValue( response )
+				: vi.fn().mockResolvedValue( response );
+		vi.stubGlobal( 'fetch', fetchMock );
+		return { fetchMock, result: sampleChatAccount.connect( 'api-key', { apiKey: ' key-1234 ' } ) };
+	};
+
+	it( 'checks the key against the models list and stores it trimmed', async () => {
+		const { fetchMock, result } = connect( { ok: true, status: 200 } );
+
+		await expect( result ).resolves.toEqual( { method: 'api-key', apiKey: 'key-1234' } );
+		expect( fetchMock ).toHaveBeenCalledWith(
+			'http://127.0.0.1:11500/v1/models',
+			expect.objectContaining( { headers: { Authorization: 'Bearer key-1234' } } )
+		);
+	} );
+
+	it( 'refuses a key the service rejects with a 401', async () => {
+		await expect( connect( { ok: false, status: 401 } ).result ).rejects.toBeInstanceOf(
+			ConnectError
+		);
+	} );
+
+	it.each( [ 500, 'offline' ] )( 'accepts a key it can’t check (%s)', async ( failure ) => {
+		const response =
+			typeof failure === 'number' ? { ok: false, status: failure } : new Error( failure );
+
+		await expect( connect( response ).result ).resolves.toMatchObject( { apiKey: 'key-1234' } );
+	} );
+} );
+
+describe( 'sample-chat ai', () => {
+	it( 'asks to connect without a config', async () => {
+		await expect( sampleChatAi.model( undefined, 'sample-qwen', {} ) ).rejects.toBeInstanceOf(
+			NotConnectedError
+		);
+	} );
+
+	it( 'serves Sample Qwen over chat completions, under the service’s model name', async () => {
+		const connection = await sampleChatAi.model(
+			{ method: 'api-key', apiKey: 'key-1234' },
+			'sample-qwen',
+			{}
+		);
+
+		expect( connection ).toMatchObject( {
+			piProvider: 'sample-chat',
+			apiKey: 'key-1234',
+			requestModelId: 'qwen2.5:0.5b',
+			model: {
+				id: 'sample-qwen',
+				api: 'openai-completions',
+				baseUrl: 'http://127.0.0.1:11500/v1',
+				input: [ 'text' ],
+				reasoning: false,
+				contextWindow: 32_768,
+				maxTokens: 2048,
+			},
+		} );
+	} );
+} );
