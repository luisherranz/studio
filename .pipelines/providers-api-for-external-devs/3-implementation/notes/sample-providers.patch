+import { NotConnectedError, RemoteSiteError } from '../errors';
+import { SAMPLE_BOTH_URL, type SampleBothSite, type sampleBothProvider } from './descriptor';
+import type { SampleBothConfig } from './config';
+import type { ServicesOf } from '../types';
+
+async function call< T >(
+	config: SampleBothConfig | undefined,
+	route: string,
+	init: RequestInit = {}
+) {
+	if ( ! config ) {
+		throw new NotConnectedError( 'Connect Sample Both to publish sites.' );
+	}
+	const token = config.method === 'api-key' ? config.apiKey : config.accessToken;
+	const response = await fetch( `${ SAMPLE_BOTH_URL }${ route }`, {
+		...init,
+		headers: { Authorization: `Bearer ${ token }`, 'Content-Type': 'application/json' },
+	} );
+	if ( response.status === 401 ) {
+		throw new NotConnectedError( 'Your Sample Both sign-in no longer works. Connect it again.' );
+	}
+	if ( ! response.ok ) {
+		throw new RemoteSiteError( `Sample Both answered ${ response.status }`, 'upload' );
+	}
+	return ( await response.json() ) as T;
+}
+
+export const sampleBothSites: ServicesOf< typeof sampleBothProvider >[ 'sites' ] = {
+	list: ( config ) => call< SampleBothSite[] >( config, '/sites' ),
+	create: ( config, { name } ) =>
+		call< SampleBothSite >( config, '/sites', {
+			method: 'POST',
+			body: JSON.stringify( { name } ),
+		} ),
+	async push( config, site, content, _options, onStatus ) {
+		if ( content.kind !== 'files' ) {
+			throw new Error( 'Sample Both publishes a static export.' );
+		}
+		for ( const [ index, file ] of content.files.entries() ) {
+			onStatus( { phase: 'uploading', progress: ( index / content.files.length ) * 100 } );
+			await call( config, `/sites/${ site.id }/files/${ encodeURIComponent( file.path ) }`, {
+				method: 'PUT',
+				body: ( await file.read() ) as BodyInit,
+			} );
+		}
+	},
+};
