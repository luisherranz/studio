+++ b/packages/providers/sample-both/account.ts
@@ -0,0 +1,79 @@
+import { __ } from '@wordpress/i18n';
+import { ConnectError, NotConnectedError } from '../errors';
+import { SAMPLE_BOTH_URL, sampleBothConnectInput, type sampleBothProvider } from './descriptor';
+import type { SampleBothConfig } from './config';
+import type { ServicesOf } from '../types';
+
+type SampleBothAccount = ServicesOf< typeof sampleBothProvider >[ 'account' ];
+
+const RENEW_MARGIN_MS = 20_000;
+
+async function requestTokens( body: Record< string, string > ): Promise< Response > {
+	return fetch( `${ SAMPLE_BOTH_URL }/oauth/token`, {
+		method: 'POST',
+		headers: { 'Content-Type': 'application/json' },
+		body: JSON.stringify( body ),
+	} );
+}
+
+async function readTokens( response: Response ): Promise< SampleBothConfig > {
+	const tokens = ( await response.json() ) as {
+		access_token: string;
+		refresh_token: string;
+		expires_in: number;
+		account: string;
+		models: string[];
+	};
+	return {
+		method: 'sign-in',
+		accessToken: tokens.access_token,
+		refreshToken: tokens.refresh_token,
+		accessTokenExpiresAt: Date.now() + tokens.expires_in * 1000,
+		account: tokens.account,
+		models: tokens.models,
+	};
+}
+
+const start: SampleBothAccount[ 'start' ] = async ( _method, { redirectUri } ) => {
+	if ( ! redirectUri ) {
+		throw new Error( 'Signing in to Sample Both needs an address on this computer.' );
+	}
+	const state = crypto.randomUUID();
+	const url = new URL( `${ SAMPLE_BOTH_URL }/authorize` );
+	url.search = new URLSearchParams( { redirect_uri: redirectUri, state } ).toString();
+	return { url: url.toString(), handoff: { state } };
+};
+
+const connect: SampleBothAccount[ 'connect' ] = async ( method, input ) => {
+	if ( method === 'api-key' ) {
+		const parsed = sampleBothConnectInput().safeParse( input );
+		if ( ! parsed.success ) {
+			throw new ConnectError( parsed.error.issues[ 0 ].message );
+		}
+		return { method: 'api-key', apiKey: parsed.data.apiKey };
+	}
+	if ( ! input.code ) {
+		throw new ConnectError( __( 'Start signing in to Sample Both again.' ) );
+	}
+	const response = await requestTokens( { grant_type: 'authorization_code', code: input.code } );
+	if ( ! response.ok ) {
+		throw new ConnectError( __( 'Sample Both sign-in could not be completed.' ), 'unverified' );
+	}
+	return readTokens( response );
+};
+
+const refresh: SampleBothAccount[ 'refresh' ] = async ( config ) => {
+	if ( config.method === 'api-key' || config.accessTokenExpiresAt - Date.now() > RENEW_MARGIN_MS ) {
+		return undefined;
+	}
+	const response = await requestTokens( {
+		grant_type: 'refresh_token',
+		refresh_token: config.refreshToken,
+	} );
+	if ( response.status === 401 ) {
+		throw new NotConnectedError( 'Your Sample Both sign-in expired. Connect Sample Both again.' );
+	}
+	return readTokens( response );
+};
+
+export const sampleBothAccount: SampleBothAccount = { start, connect, refresh };
