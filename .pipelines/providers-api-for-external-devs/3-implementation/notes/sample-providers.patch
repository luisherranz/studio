+import { __ } from '@wordpress/i18n';
+import { z } from 'zod';
+import { previewApiKey } from '../api-key';
+import { defineProvider, type AiModel } from '../types';
+import { sampleBothConfigSchema } from './config';
+
+export const SAMPLE_BOTH_URL = 'http://127.0.0.1:11600';
+
+export const SAMPLE_BOTH_AI_MODELS = [
+	{ id: 'both-small', label: () => 'Both Small', supportsImages: false },
+	{ id: 'both-large', label: () => 'Both Large', supportsImages: false },
+] as const satisfies readonly AiModel[];
+
+type SampleBothModelId = ( typeof SAMPLE_BOTH_AI_MODELS )[ number ][ 'id' ];
+
+export const sampleBothConnectInput = () =>
+	z.object( {
+		apiKey: z
+			.string()
+			.trim()
+			.min( 1, __( 'API key is required' ) )
+			.meta( { title: __( 'Sample Both API key' ), writeOnly: true } ),
+	} );
+
+// A site on Sample Both.
+export interface SampleBothSite {
+	id: string;
+	name: string;
+	url: string;
+}
+
+export const sampleBothProvider = defineProvider( {
+	id: 'sample-both',
+	label: 'Sample Both',
+	description: () => __( 'Chat with Sample Both models and publish static copies of your sites.' ),
+	account: {
+		configSchema: sampleBothConfigSchema,
+		methods: [
+			{ id: 'sign-in', label: () => __( 'Sign in' ), kind: 'loopback' },
+			{ id: 'api-key', label: () => __( 'API key' ), kind: 'form', input: sampleBothConnectInput },
+		],
+		describe: ( config ) =>
+			config.method === 'api-key'
+				? { method: config.method, summary: previewApiKey( config.apiKey ) }
+				: {
+						method: config.method,
+						summary: config.account,
+						models: config.models.filter( ( id ): id is SampleBothModelId =>
+							SAMPLE_BOTH_AI_MODELS.some( ( model ) => model.id === id )
+						),
+				  },
+		remember: () => undefined,
+	},
+	ai: { models: SAMPLE_BOTH_AI_MODELS, defaultModel: 'both-small' },
+	sites: {
+		pull: false,
+		selective: false,
+		content: 'static',
+		newSite: 'create',
+		intro: {
+			title: () => __( 'Publish to Sample Both' ),
+			description: () => __( 'Publish a static copy of your site to Sample Both.' ),
+			learnMoreUrl: SAMPLE_BOTH_URL,
+		},
+		describe: ( site: SampleBothSite ) => ( {
+			details: [],
+			links: [ { title: __( 'Open site' ), url: site.url } ],
+		} ),
+		issue: () => null,
+		withDetails: ( connections, sites ) =>
+			connections.map( ( connection ) => ( {
+				...connection,
+				...sites.find( ( site ) => site.id === connection.id ),
+			} ) ),
+	},
+} );
