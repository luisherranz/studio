--- /dev/null
+++ b/packages/providers/sample-hosting/api.ts
@@ -0,0 +1,143 @@
+import type { SampleSite } from './descriptor';
+import type { PushContent } from '../types';
+
+const API_URL = 'http://127.0.0.1:11600';
+
+export class SampleHostingApiError extends Error {
+	constructor(
+		message: string,
+		readonly status: number,
+		readonly code?: string
+	) {
+		super( message );
+		this.name = 'SampleHostingApiError';
+	}
+}
+
+async function request< T >(
+	route: string,
+	{
+		token,
+		method = 'GET',
+		body,
+		signal,
+	}: { token?: string; method?: string; body?: unknown; signal?: AbortSignal } = {}
+): Promise< T > {
+	const response = await fetch( `${ API_URL }${ route }`, {
+		method,
+		headers: {
+			...( token ? { Authorization: `Bearer ${ token }` } : {} ),
+			...( body === undefined ? {} : { 'Content-Type': 'application/json' } ),
+		},
+		body: body === undefined ? undefined : JSON.stringify( body ),
+		signal,
+	} );
+	const json = await response.json().catch( () => null );
+	if ( ! response.ok ) {
+		throw new SampleHostingApiError(
+			`Sample Hosting request failed with status ${ response.status }`,
+			response.status,
+			json?.error
+		);
+	}
+	return json as T;
+}
+
+// A pending device sign-in: the user approves `userCode` at `verificationUrl`.
+interface DeviceAuthorization {
+	deviceCode: string;
+	userCode: string;
+	verificationUrl: string;
+	// Seconds between checks for the approval.
+	interval: number;
+	// When the code stops working, in milliseconds since the epoch.
+	expiresAt: number;
+}
+
+export async function startDeviceLogin(): Promise< DeviceAuthorization > {
+	const data = await request< {
+		device_code: string;
+		user_code: string;
+		verification_uri: string;
+		interval: number;
+		expires_in: number;
+	} >( '/device/code', { method: 'POST' } );
+	return {
+		deviceCode: data.device_code,
+		userCode: data.user_code,
+		verificationUrl: data.verification_uri,
+		interval: data.interval,
+		expiresAt: Date.now() + data.expires_in * 1000,
+	};
+}
+
+function sleep( ms: number ): Promise< void > {
+	return new Promise( ( resolve ) => setTimeout( resolve, ms ) );
+}
+
+// Polls until the user approves the code. Throws a 403 error when they decline it, and a 400 one
+// when the code is unknown or has expired.
+export async function waitForDeviceLogin( login: {
+	deviceCode: string;
+	interval: number;
+	expiresAt: number;
+} ): Promise< { accessToken: string; account: string } > {
+	while ( Date.now() < login.expiresAt ) {
+		try {
+			const data = await request< { access_token: string; account: string } >( '/device/token', {
+				method: 'POST',
+				body: { device_code: login.deviceCode },
+			} );
+			return { accessToken: data.access_token, account: data.account };
+		} catch ( error ) {
+			if ( ! ( error instanceof SampleHostingApiError ) || error.status !== 428 ) {
+				throw error;
+			}
+		}
+		await sleep( login.interval * 1000 );
+	}
+	throw new SampleHostingApiError( 'Sample Hosting sign-in expired.', 400, 'expired' );
+}
+
+export function listSites( token: string ): Promise< SampleSite[] > {
+	return request< SampleSite[] >( '/sites', { token } );
+}
+
+export function createSite( token: string, name: string ): Promise< SampleSite > {
+	return request< SampleSite >( '/sites', { token, method: 'POST', body: { name } } );
+}
+
+// Sends the archive as the request body: the page hands over a Blob, and Node a readable stream,
+// which fetch sends as it reads it.
+export async function uploadArchive(
+	token: string,
+	siteId: string,
+	archive: Extract< PushContent, { kind: 'archive' } >,
+	signal?: AbortSignal
+): Promise< void > {
+	const { file, name, size } = archive;
+	const isBlob = file instanceof Blob;
+	try {
+		const response = await fetch( `${ API_URL }/sites/${ encodeURIComponent( siteId ) }/archive`, {
+			method: 'PUT',
+			headers: {
+				Authorization: `Bearer ${ token }`,
+				'x-archive-name': name,
+				...( isBlob ? {} : { 'Content-Length': String( size ) } ),
+			},
+			body: file as BodyInit,
+			...( isBlob ? {} : { duplex: 'half' } ),
+			signal,
+		} as RequestInit );
+		if ( ! response.ok ) {
+			throw new SampleHostingApiError(
+				`Sample Hosting request failed with status ${ response.status }`,
+				response.status
+			);
+		}
+	} finally {
+		if ( ! isBlob ) {
+			( file as { destroy?: () => void } ).destroy?.();
+		}
+	}
+}
