@@ -0,0 +1,56 @@
+import { __ } from '@wordpress/i18n';
+import { NotConnectedError, RemoteSiteError } from '../errors';
+import { createSite, listSites, SampleHostingApiError, uploadArchive } from './api';
+import type { SampleHostingConfig } from './config';
+import type { sampleHostingProvider } from './descriptor';
+import type { ServicesOf } from '../types';
+
+function requireToken( config: SampleHostingConfig | undefined ): string {
+	if ( ! config?.accessToken ) {
+		throw new NotConnectedError( __( 'Connect Sample Hosting to publish sites.' ) );
+	}
+	return config.accessToken;
+}
+
+async function step< T >( message: string, code: string, run: () => Promise< T > ): Promise< T > {
+	try {
+		return await run();
+	} catch ( error ) {
+		if ( error instanceof NotConnectedError ) {
+			throw error;
+		}
+		if ( error instanceof SampleHostingApiError && error.status === 401 ) {
+			throw new NotConnectedError(
+				__( 'Your Sample Hosting sign-in no longer works. Connect Sample Hosting again.' )
+			);
+		}
+		throw new RemoteSiteError(
+			error instanceof SampleHostingApiError ? `${ message }: ${ error.message }` : message,
+			code,
+			{ cause: error }
+		);
+	}
+}
+
+export const sampleHostingSites: ServicesOf< typeof sampleHostingProvider >[ 'sites' ] = {
+	list: ( config ) =>
+		step( __( 'Failed to load your Sample Hosting sites' ), 'site_fetch', () =>
+			listSites( requireToken( config ) )
+		),
+
+	create: ( config, { name } ) =>
+		step( __( 'Failed to create the Sample Hosting site' ), 'site_create', () =>
+			createSite( requireToken( config ), name )
+		),
+
+	async push( config, site, content, _options, onStatus, signal ) {
+		const token = requireToken( config );
+		if ( content.kind !== 'archive' ) {
+			throw new Error( 'Sample Hosting publishes a WordPress archive.' );
+		}
+		await step( __( 'Failed to publish to Sample Hosting' ), 'upload', async () => {
+			onStatus( { phase: 'uploading' } );
+			await uploadArchive( token, String( site.id ), content, signal );
+		} );
+	},
+};
