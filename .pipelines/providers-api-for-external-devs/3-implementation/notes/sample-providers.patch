+import { __ } from '@wordpress/i18n';
+import { defineProvider } from '../types';
+import { sampleHostingConfigSchema } from './config';
+
+const SAMPLE_HOSTING_URL = 'http://127.0.0.1:11600';
+
+// A site on Sample Hosting.
+export interface SampleSite {
+	id: string;
+	name: string;
+	url: string;
+}
+
+export const sampleHostingProvider = defineProvider( {
+	id: 'sample-hosting',
+	label: 'Sample Hosting',
+	description: () => __( 'Publish your sites to Sample Hosting.' ),
+	learnMoreUrl: SAMPLE_HOSTING_URL,
+	account: {
+		configSchema: sampleHostingConfigSchema,
+		methods: [ { id: 'sign-in', label: () => __( 'Sign in' ), kind: 'device' } ],
+		describe: ( { account } ) => ( { method: 'sign-in', summary: account } ),
+	},
+	sites: {
+		pull: false,
+		selective: false,
+		content: 'archive',
+		newSite: 'create',
+		intro: {
+			title: () => __( 'Publish to Sample Hosting' ),
+			description: () => __( 'Publish a copy of your site to a Sample Hosting site.' ),
+			learnMoreUrl: SAMPLE_HOSTING_URL,
+		},
+		describe: ( site: SampleSite ) => ( {
+			details: [],
+			links: [ { title: __( 'Open site' ), url: site.url } ],
+		} ),
+		issue: () => null,
+		// A site renamed on Sample Hosting shows its new name; one gone from the account keeps the
+		// stored one.
+		withDetails: ( connections, sites ) =>
+			connections.map( ( connection ) => ( {
+				...connection,
+				...sites.find( ( site ) => site.id === connection.id ),
+			} ) ),
+	},
+} );
