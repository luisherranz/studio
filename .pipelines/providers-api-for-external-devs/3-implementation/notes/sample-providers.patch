+import { __ } from '@wordpress/i18n';
+import { ConnectError } from '../errors';
+import { SampleHostingApiError, startDeviceLogin, waitForDeviceLogin } from './api';
+import type { sampleHostingProvider } from './descriptor';
+import type { ServicesOf } from '../types';
+
+export const sampleHostingAccount: ServicesOf< typeof sampleHostingProvider >[ 'account' ] = {
+	async start() {
+		const login = await startDeviceLogin();
+		return {
+			url: login.verificationUrl,
+			code: login.userCode,
+			handoff: {
+				deviceCode: login.deviceCode,
+				interval: String( login.interval ),
+				expiresAt: String( login.expiresAt ),
+			},
+		};
+	},
+
+	// Takes back the handoff `start` returned, and resolves once the user approves the sign-in.
+	async connect( _method, input ) {
+		const interval = Number( input.interval );
+		const expiresAt = Number( input.expiresAt );
+		if ( ! input.deviceCode || ! expiresAt || ! interval ) {
+			throw new ConnectError( __( 'Start signing in to Sample Hosting again.' ) );
+		}
+		try {
+			return await waitForDeviceLogin( { deviceCode: input.deviceCode, interval, expiresAt } );
+		} catch ( error ) {
+			if ( error instanceof SampleHostingApiError && error.status === 403 ) {
+				throw new ConnectError( __( 'Sample Hosting sign-in was declined.' ), 'denied' );
+			}
+			if ( error instanceof SampleHostingApiError && error.status === 400 ) {
+				throw new ConnectError( __( 'The Sample Hosting sign-in expired. Try again.' ), 'invalid' );
+			}
+			throw new ConnectError(
+				error instanceof Error ? error.message : String( error ),
+				'unverified'
+			);
+		}
+	},
+};
