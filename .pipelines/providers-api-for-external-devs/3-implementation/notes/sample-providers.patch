+import { z } from 'zod';
+
+export const sampleBothConfigSchema = z.discriminatedUnion( 'method', [
+	z.object( { method: z.literal( 'api-key' ), apiKey: z.string().min( 1 ) } ),
+	z.object( {
+		method: z.literal( 'sign-in' ),
+		accessToken: z.string().min( 1 ),
+		refreshToken: z.string().min( 1 ),
+		// When the access token stops working; the refresh token renews it.
+		accessTokenExpiresAt: z.number(),
+		account: z.string(),
+		// The models the account's plan runs.
+		models: z.array( z.string() ),
+	} ),
+] );
+
+export type SampleBothConfig = z.infer< typeof sampleBothConfigSchema >;
