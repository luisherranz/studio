+import { __ } from '@wordpress/i18n';
+import { ConnectError } from '../errors';
+import { sampleChatConnectInput, type sampleChatProvider } from './descriptor';
+import type { ServicesOf } from '../types';
+
+export const SAMPLE_CHAT_API_URL = 'http://127.0.0.1:11500/v1';
+
+// Listing models costs nothing. A 401 means the key is rejected; a key that can't be checked
+// (the service is down, any other status) is accepted.
+export const sampleChatAccount: ServicesOf< typeof sampleChatProvider >[ 'account' ] = {
+	async connect( _method, input ) {
+		const parsed = sampleChatConnectInput().safeParse( input );
+		if ( ! parsed.success ) {
+			throw new ConnectError( parsed.error.issues[ 0 ].message );
+		}
+		const { apiKey } = parsed.data;
+		const response = await fetch( `${ SAMPLE_CHAT_API_URL }/models`, {
+			headers: { Authorization: `Bearer ${ apiKey }` },
+		} ).catch( () => undefined );
+		if ( response?.status === 401 ) {
+			throw new ConnectError(
+				__( 'Sample Chat rejected this API key. Check the key and try again.' )
+			);
+		}
+		return { method: 'api-key', apiKey };
+	},
+};
