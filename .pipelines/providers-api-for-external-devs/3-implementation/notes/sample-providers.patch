+import { NotConnectedError } from '../errors';
+import { SAMPLE_BOTH_AI_MODELS, SAMPLE_BOTH_URL, type sampleBothProvider } from './descriptor';
+import type { SampleBothConfig } from './config';
+import type { ServicesOf } from '../types';
+
+function credential( config: SampleBothConfig ): string {
+	return config.method === 'api-key' ? config.apiKey : config.accessToken;
+}
+
+export const sampleBothAi: ServicesOf< typeof sampleBothProvider >[ 'ai' ] = {
+	async model( config, modelId ) {
+		if ( ! config ) {
+			throw new NotConnectedError( 'Connect Sample Both to use its models.' );
+		}
+		const listed = SAMPLE_BOTH_AI_MODELS.find( ( { id } ) => id === modelId )!;
+		return {
+			piProvider: 'sample-both',
+			apiKey: credential( config ),
+			requestModelId: 'qwen2.5:0.5b',
+			model: {
+				id: listed.id,
+				name: listed.label(),
+				api: 'openai-completions',
+				provider: 'sample-both',
+				baseUrl: 'http://127.0.0.1:11500/v1',
+				reasoning: false,
+				input: [ 'text' ],
+				cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+				contextWindow: 32_768,
+				maxTokens: 2048,
+			},
+		};
+	},
+	async generateImages( config, requests, onResult ) {
+		if ( ! config ) {
+			throw new NotConnectedError( 'Connect Sample Both to generate images.' );
+		}
+		return Promise.all(
+			requests.map( async ( { prompt }, index ) => {
+				const response = await fetch( `${ SAMPLE_BOTH_URL }/images`, {
+					method: 'POST',
+					headers: {
+						Authorization: `Bearer ${ credential( config ) }`,
+						'Content-Type': 'application/json',
+					},
+					body: JSON.stringify( { prompt } ),
+				} );
+				const result = response.ok
+					? {
+							ok: true,
+							bytes: Uint8Array.from( atob( ( await response.json() ).png ), ( c ) =>
+								c.charCodeAt( 0 )
+							),
+					  }
+					: { ok: false, error: `Sample Both answered ${ response.status }` };
+				onResult?.( index, result );
+				return result;
+			} )
+		);
+	},
+};
