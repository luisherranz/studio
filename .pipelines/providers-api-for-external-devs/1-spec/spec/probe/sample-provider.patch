@@ -0,0 +1,32 @@
+import { __ } from '@wordpress/i18n';
+import { z } from 'zod';
+import { exampleConfigSchema, type ExampleConfig } from './config';
+import type { AiModel, Provider } from '../types';
+
+export const EXAMPLE_AI_MODELS = [
+	{ id: 'example-large', label: () => 'Example Large' },
+] as const satisfies readonly AiModel[];
+
+export const exampleConnectInput = () =>
+	z.object( {
+		apiKey: z
+			.string()
+			.trim()
+			.min( 1, __( 'API key is required' ) )
+			.meta( { title: __( 'Example API key' ), writeOnly: true } ),
+	} );
+
+export const exampleProvider: Provider< ExampleConfig > = {
+	id: 'example',
+	label: 'Example',
+	description: () => __( 'Use Example models with an API key.' ),
+	account: {
+		configSchema: exampleConfigSchema,
+		methods: [ { id: 'api-key', label: () => __( 'API key' ), kind: 'form', input: exampleConnectInput } ],
+		describe: ( { apiKey } ) => ( { method: 'api-key', summary: `...${ apiKey.slice( -4 ) }` } ),
+	},
+	ai: {
+		models: EXAMPLE_AI_MODELS,
+		defaultModel: 'example-large',
+	},
+};
diff --git a/packages/providers/example/services.ts b/packages/providers/example/services.ts
new file mode 100644
index 000000000..bd29ebf6e
--- /dev/null
+++ b/packages/providers/example/services.ts
@@ -0,0 +1,40 @@
+import { ConnectError, NotConnectedError } from '../errors';
+import { exampleConnectInput } from './descriptor';
+import type { ExampleConfig } from './config';
+import type { ProviderServices } from '../types';
+
+export const exampleServices: ProviderServices< ExampleConfig > = {
+	id: 'example',
+	account: {
+		async connect( _method, input ) {
+			const parsed = exampleConnectInput().safeParse( input );
+			if ( ! parsed.success ) {
+				throw new ConnectError( parsed.error.issues[ 0 ].message );
+			}
+			return { method: 'api-key', apiKey: parsed.data.apiKey };
+		},
+	},
+	ai: {
+		async model( config, modelId ) {
+			if ( ! config ) {
+				throw new NotConnectedError( 'Connect Example with an API key.' );
+			}
+			return {
+				piProvider: 'example',
+				apiKey: config.apiKey,
+				model: {
+					id: modelId,
+					name: 'Example Large',
+					api: 'openai-completions',
+					provider: 'example',
+					baseUrl: 'https://api.example.com/v1',
+					reasoning: false,
+					input: [ 'text' ],
+					cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+					contextWindow: 128_000,
+					maxTokens: 8_000,
+				},
+			};
+		},
+	},
+};
